[
{{ $sections := slice "tools" "languages" "frameworks" "books" "courses" "resources" "stacks" "paths" "newsletters" -}}
{{ $items := slice -}}
{{ range .Site.RegularPages -}}
  {{ if in $sections .Section -}}
    {{ $p := .Params -}}
    {{ $item := dict
      "type"        .Section
      "name"        ($p.name        | default .Title)
      "slug"        ($p.slug        | default .File.BaseFileName)
      "url"         .RelPermalink
      "description" ($p.description | default "")
      "tags"        ($p.tags        | default slice)
    -}}
    {{ $items = $items | append $item -}}
  {{ end -}}
{{ end -}}
{{ range $i, $item := $items -}}
{{ $item | jsonify }}{{ if lt $i (sub (len $items) 1) }},{{ end }}
{{ end -}}
]
